# Bring-up ADB: start after FunctionFS and /data are available.
on post-fs-data && property:ro.debuggable=1
    setprop service.adb.root 1
    setprop sys.usb.config adb

# Override a saved USB configuration that may have disabled ADB.
on property:ro.persistent_properties.ready=true && property:ro.debuggable=1
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb
